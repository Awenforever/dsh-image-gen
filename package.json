{
  "name": "dsh-image-gen",
  "version": "0.1.0",
  "description": "Text-to-image generation tool for DSH, backed by an OpenAI-compatible /v1/images/generations endpoint.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "image",
    "text-to-image",
    "qwen-image"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "author": "Awenforever",
  "homepage": "https://github.com/Awenforever/dsh-image-gen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awenforever/dsh-image-gen.git"
  },
  "bugs": {
    "url": "https://github.com/Awenforever/dsh-image-gen/issues"
  }
}
